+private let ciContext = CIContext()
+
+// Converts to grayscale and boosts contrast moderately before OCR runs.
+//
+// Three other things were tried and reverted here, each making real test
+// photos worse rather than better:
+// - CISharpenLuminance on top of this amplified JPEG compression noise and
+//   glare edges into artifacts that made the OCR engine detect no text at
+//   all (worse than a plain misread digit).
+// - CIHighlightShadowAdjust for glare reduction crushed naturally light-gray
+//   LCD backgrounds (not actually blown-out glare) down to near-black,
+//   destroying the contrast between the background and the digit segments.
+// - CIColorInvert (light-on-dark instead of the LCDs' natural dark-on-light)
+//   also made real photos read worse, not better.
+// This plain grayscale+contrast version is the only one that's actually
+// tested as working (detects and mostly reads bowser display text
+// correctly) — stop reaching for further blind filter tweaks here; Vision/
+// MLKit are already tuned for natural photos, and manual preprocessing has
+// consistently hurt more than helped in testing. For a stubborn low-
+// contrast display, a manual correction on the review screen (every field
+// is editable) is the practical answer, not further image filters.
+private func enhancedForOCR(_ image: UIImage) -> UIImage {
+  guard let ciImage = CIImage(image: image) else { return image }
+
+  let adjusted = ciImage.applyingFilter("CIColorControls", parameters: [
+    kCIInputSaturationKey: 0.0,
+    kCIInputContrastKey: 1.35,
+    kCIInputBrightnessKey: 0.0,
+  ])
+
+  guard let cgImage = ciContext.createCGImage(adjusted, from: ciImage.extent) else {
+    return image
+  }
+
+  return UIImage(cgImage: cgImage, scale: image.scale, orientation: image.imageOrientation)
+}
